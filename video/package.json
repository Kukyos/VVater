{
  "name": "vvater-film",
  "version": "1.0.0",
  "private": true,
  "description": "The VVater film. Script and sources in docs/21-film.md.",
  "scripts": {
    "clips": "node capture.cjs",
    "check": "node check.mjs",
    "studio": "node check.mjs --soft && remotion studio",
    "render": "node check.mjs && remotion render Film out/vvater-film.mp4 --codec=h264 --crf=16"
  },
  "dependencies": {
    "@remotion/cli": "4.0.409",
    "@remotion/google-fonts": "4.0.409",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.409"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "puppeteer-core": "^25.11.0",
    "typescript": "5.9.3"
  }
}
