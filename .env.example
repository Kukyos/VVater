# Local secrets. Copy to .env; it is gitignored.

# ---- Copernicus Marine Service (https://data.marine.copernicus.eu)
# A free account. Needed for the global cubes, currents and the layers around the block.
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# ---- Assistant
# AIRouter (api.airouter.in), OpenAI-compatible. Models are tried in order.
AI_ROUTER_KEY=
AI_ROUTER_MODEL=openai/gpt-4.1-mini,google/gemini-2.5-flash,deepseek/deepseek-v4-flash
